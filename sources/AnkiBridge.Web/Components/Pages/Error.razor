@page "/Error"
@using System.Diagnostics
@inject NavigationManager Navigation

<PageTitle>Error - AnkiBridge</PageTitle>

<main class="error-page">
    <h1>We could not complete that request</h1>
    <p>An unexpected error occurred. Return to the workspace and try the operation again.</p>

    @if (ShowRequestId)
    {
        <div class="request-id">
            <strong>Request ID:</strong> <code>@requestId</code>
        </div>
    }

    <div class="error-actions">
        <a class="primary-link" href="/">Return to overview</a>
        <FluentButton Appearance="Appearance.Stealth" OnClick="ReloadPage">Reload page</FluentButton>
    </div>
</main>

@code {
    [CascadingParameter]
    public HttpContext? HttpContext { get; set; }

    private string? requestId;
    private bool ShowRequestId => !string.IsNullOrEmpty(requestId);

    protected override void OnInitialized()
    {
        requestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
    }

    private void ReloadPage()
        => Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
}
