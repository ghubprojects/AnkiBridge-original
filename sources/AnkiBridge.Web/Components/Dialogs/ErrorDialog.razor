@rendermode InteractiveServer

<FluentDialog>
    <FluentDialogHeader>
        <FluentStack VerticalAlignment="VerticalAlignment.Center" HorizontalGap="10">
            <FluentIcon Value="@(new Icons.Regular.Size24.DismissCircle())" Color="Color.Error" />
            <FluentLabel Typo="Typography.PaneHeader">Something went wrong</FluentLabel>
        </FluentStack>
    </FluentDialogHeader>

    <FluentDialogBody>
        <p class="error-summary">AnkiBridge could not complete the current operation.</p>
        <div class="error-message">@Message</div>
        <p class="error-guidance">Reload the page and try again. Your previously saved data is not affected.</p>
    </FluentDialogBody>

    <FluentDialogFooter>
        <FluentStack HorizontalAlignment="HorizontalAlignment.Right">
            <FluentButton Appearance="Appearance.Accent"
                          IconStart="@(new Icons.Regular.Size20.ArrowClockwise())"
                          OnClick="HandleRefresh">
                Reload page
            </FluentButton>
        </FluentStack>
    </FluentDialogFooter>
</FluentDialog>
