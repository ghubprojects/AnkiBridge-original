@inherits LayoutComponentBase

@using AnkiBridge.Web.Components.Dialogs

<div class="wrapper">
    <FluentLayout>
        <FluentHeader>
            AnkiBridge
        </FluentHeader>
        <FluentStack Class="main" Orientation="Orientation.Horizontal" Width="100%" HorizontalGap="0">
            <NavMenu />
            <FluentBodyContent Class="body-content">
                <ErrorBoundary @ref="errorBoundary">
                    <ChildContent>
                        <div class="content">
                            @Body
                        </div>
                    </ChildContent>
                    <ErrorContent Context="exception">
                        <ErrorDialog Exception="exception" />
                    </ErrorContent>
                </ErrorBoundary>
            </FluentBodyContent>
        </FluentStack>
        <FluentFooter />
        <FluentMenuProvider @rendermode="RenderMode.InteractiveServer" />
        <FluentDialogProvider @rendermode="RenderMode.InteractiveServer" />
        <FluentToastProvider @rendermode="RenderMode.InteractiveServer" />
    </FluentLayout>
</div>