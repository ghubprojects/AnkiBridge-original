{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AnkiConnect": {
    "BaseUrl": "http://localhost:8765"
  },
  "Storage": {
    "ContainerName": "uploads",
    "PublicEndpoint": null
  },
  "Dictionary": {
    "Cambridge": {
      "BaseUrl": "https://dictionary.cambridge.org/dictionary",
      "TimeoutSeconds": 15
    }
  },
  "Speech": {
    "Google": {
      "BaseUrl": "https://translate.google.com/translate_tts",
      "DefaultLanguage": "en",
      "Client": "tw-ob"
    }
  },
  "Translation": {
    "Google": {
      "BaseUrl": "https://translate.googleapis.com",
      "SourceLanguage": "en",
      "TargetLanguage": "vi",
      "TimeoutSeconds": 10
    }
  },
  "Images": {
    "Pixabay": {
      "BaseUrl": "https://pixabay.com/api/",
      "ImageType": "photo",
      "Language": "en",
      "SafeSearch": true,
      "TimeoutSeconds": 10
    },
    "Pexels": {
      "BaseUrl": "https://api.pexels.com/v1/search",
      "Locale": "en-US",
      "Orientation": "",
      "TimeoutSeconds": 10
    }
  }
}
