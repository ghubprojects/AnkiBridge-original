{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Dictionary": {
    "Cambridge": {
      "BaseUrl": "https://dictionary.cambridge.org/dictionary/english",
      "TimeoutSeconds": 15,
      "MaxDefinitionsPerEntry": 5,
      "MaxExamplesPerDefinition": 3
    }
  },
  "Speech": {
    "Google": {
      "DefaultLanguage": "en",
      "Client": "tw-ob"
    }
  },
  "Images": {
    "Pixabay": {
      "ApiKey": "YOUR_PIXABAY_KEY",
      "ImageType": "photo",
      "Language": "en",
      "SafeSearch": true
    },
    "Pexels": {
      "ApiKey": "YOUR_PEXELS_KEY",
      "Locale": "en-US",
      "Orientation": ""
    }
  }
}
