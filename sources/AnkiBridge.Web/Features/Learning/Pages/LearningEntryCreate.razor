@page "/learning-entries/create"
@rendermode InteractiveServer
@inherits RootComponentBase

@using AnkiBridge.Domain.Enums
@using AnkiBridge.Web.Features.Learning.Models
@using AnkiBridge.Web.Components.Abstractions

<div class="wrapper">
    <PageTitle>Create a learning entry - AnkiBridge</PageTitle>

    <div style="margin-bottom: 1.5rem;">
        <h3>Create a learning entry</h3>
        <p style="margin-top: 4px;">Fill in the details to enrich your vocabulary.</p>
    </div>

    <FluentStack Orientation="Orientation.Vertical" Class="form-card">
        <FluentEditForm EditContext="ViewModel.EditContext" style="width:100%">
            <DataAnnotationsValidator />

            <FluentStack Orientation="Orientation.Vertical" VerticalGap="12">
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="12">
                    <FluentStack Style="align-items:center;">
                        <FluentStack>
                            <div class="section-header-indicator"></div>
                            <div class="section-header-title">Core Information</div>
                        </FluentStack>
                        <FluentSpacer />
                        <FluentBadge Appearance="Appearance.Neutral" Class="dictionary-source-badge">
                            Cambridge
                        </FluentBadge>
                    </FluentStack>

                    <FluentStack Orientation="Orientation.Vertical" Style="display:flex">
                        <FluentStack Style="display:flex;align-items:end">
                            <FluentAutocomplete TOption="DictionaryEntryOption"
                                                OnOptionsSearch="@SearchDictionaryEntriesAsync"
                                                Name="Headword"
                                                SelectedOption="@ViewModel.SelectedEntry"
                                                SelectedOptionChanged="@OnSelectedEntryChangedAsync"
                                                OptionValue="@(item => item.Headword)"
                                                OptionText="@(item => item.DisplayName)"
                                                ValueText="@ViewModel.Headword"
                                                ValueTextChanged="@(text => ViewModel.Headword = text)"
                                                Label="Headword"
                                                Required="true"
                                                Autofocus="true"
                                                Multiple="false"
                                                Style="flex:1;" />
                            <FluentButton OnClick="@ScrapeFromDictionaryOnlineAsync"
                                          IconStart="@(new Icons.Regular.Size20.Wand())"
                                          Loading="@ViewModel.IsScrapingOnline"
                                          Style="margin-bottom:3px;">
                                Scrape online
                            </FluentButton>
                        </FluentStack>
                        <FluentValidationMessage For="@(() => ViewModel.Headword)" />
                    </FluentStack>

                    <FluentStack>
                        <FluentStack Orientation="Orientation.Vertical" Style="display:flex">
                            <FluentSelect TOption="Option<PartOfSpeech>"
                                          Name="PartOfSpeech"
                                          Label="Part of speech"
                                          Items="@ViewModel.PartOfSpeechOptions"
                                          OptionText="@(p => p.Text)"
                                          OptionValue="@(p => p.Value.ToString())"
                                          Value="@ViewModel.PartOfSpeech.ToString()"
                                          ValueChanged="@(v => { if(Enum.TryParse<PartOfSpeech>(v, out var r)) ViewModel.PartOfSpeech = r; })"
                                          Required="true"
                                          Style="width:100%;" />
                            <FluentValidationMessage For="@(() => ViewModel.PartOfSpeech)" />
                        </FluentStack>
                        <FluentStack Orientation="Orientation.Vertical" Style="display:flex">
                            <FluentTextField @bind-Value="ViewModel.Cloze"
                                             Name="Cloze"
                                             Label="Cloze"
                                             Required="true"
                                             Style="width:100%;" />
                            <FluentValidationMessage For="@(() => ViewModel.Cloze)" />
                        </FluentStack>
                    </FluentStack>

                    <FluentStack Orientation="Orientation.Vertical" Style="display:flex">
                        <FluentCombobox TOption="string"
                                        Value="@ViewModel.Definition"
                                        ValueChanged="ViewModel.HandleDefinitionChanged"
                                        Name="Definition"
                                        Label="Definition"
                                        Items="ViewModel.DefinitionOptions"
                                        Required="true"
                                        Style="width:100%;" />
                        <FluentValidationMessage For="@(() => ViewModel.Definition)" />
                    </FluentStack>

                    <FluentStack Orientation="Orientation.Vertical" Style="display:flex">
                        <FluentLabel Typo="Typography.Body">Examples</FluentLabel>
                        <FluentCombobox TOption="string"
                                        @bind-Value="ViewModel.Example1"
                                        Name="Example1"
                                        Placeholder="Example 1"
                                        Items="ViewModel.ExampleOptions"
                                        Style="width:100%;" />
                        <FluentCombobox TOption="string"
                                        @bind-Value="ViewModel.Example2"
                                        Name="Example2"
                                        Placeholder="Example 2"
                                        Items="ViewModel.ExampleOptions"
                                        Style="width:100%;" />
                        <FluentCombobox TOption="string"
                                        @bind-Value="ViewModel.Example3"
                                        Name="Example3"
                                        Placeholder="Example 3"
                                        Items="ViewModel.ExampleOptions"
                                        Style="width:100%;" />
                    </FluentStack>
                </FluentStack>

                <FluentStack Orientation="Orientation.Vertical" VerticalGap="12" Style="margin-top:24px">
                    <FluentStack>
                        <div class="section-header-indicator"></div>
                        <div class="section-header-title">Translation</div>
                    </FluentStack>

                    <FluentStack>
                        <FluentStack Orientation="Orientation.Vertical" Style="display:flex">
                            <FluentSelect TOption="Option<TranslationSource>"
                                          Name="TranslationSource"
                                          Label="Translation source"
                                          Items="@ViewModel.TranslationSourceOptions"
                                          OptionText="@(p => p.Text)"
                                          OptionValue="@(p => p.Value.ToString())"
                                          Value="@ViewModel.TranslationSource.ToString()"
                                          ValueChanged="@(v => { if(Enum.TryParse<TranslationSource>(v, out var r)) ViewModel.TranslationSource = r; })"
                                          Required="true"
                                          Style="width:100%;" />
                            <FluentValidationMessage For="@(() => ViewModel.TranslationSource)" />
                        </FluentStack>

                        <FluentStack Orientation="Orientation.Vertical" Style="display:flex">
                            <FluentTextField @bind-Value="ViewModel.Translation"
                                             Name="Translation"
                                             Label="Translation"
                                             Required="true"
                                             Style="width:100%;" />
                            <FluentValidationMessage For="@(() => ViewModel.Translation)" />
                        </FluentStack>
                    </FluentStack>
                </FluentStack>

                <FluentStack Orientation="Orientation.Vertical" VerticalGap="12" Style="margin-top:24px">
                    <FluentStack>
                        <div class="section-header-indicator"></div>
                        <div class="section-header-title">Pronunciation</div>
                    </FluentStack>

                    <FluentStack>
                        <FluentStack Orientation="Orientation.Vertical" Style="display:flex">
                            <FluentStack Style="display:flex;align-items:end">
                                <FluentStack Orientation="Orientation.Vertical" Style="flex:1">
                                    <FluentSelect TOption="Option<Accent>"
                                                  Name="Accent"
                                                  Label="Accent"
                                                  Items="@ViewModel.AccentOptions"
                                                  OptionText="@(p => p.Text)"
                                                  OptionValue="@(p => p.Value.ToString())"
                                                  Value="@ViewModel.Accent.ToString()"
                                                  ValueChanged="@(v => { if(Enum.TryParse<Accent>(v, out var r)) ViewModel.Accent = r; })"
                                                  Required="true"
                                                  Style="width:100%;" />
                                </FluentStack>
                                <FluentButton OnClick="@GenerateIpaAsync"
                                              Loading="@ViewModel.IsGeneratingIpa"
                                              Disabled="@string.IsNullOrWhiteSpace(ViewModel.Headword)">
                                    <div class="generate-ipa-icon">/æ/</div>
                                    Generate IPA
                                </FluentButton>
                            </FluentStack>
                            <FluentValidationMessage For="@(() => ViewModel.Accent)" />
                        </FluentStack>
                    </FluentStack>

                    <FluentStack Orientation="Orientation.Vertical" Style="display:flex">
                        <FluentTextField @bind-Value="ViewModel.Ipa"
                                         Name="Ipa"
                                         Label="IPA"
                                         Required="true"
                                         Style="width:100%;" />
                        <FluentValidationMessage For="@(() => ViewModel.Ipa)" />
                    </FluentStack>

                    <FluentStack Orientation="Orientation.Vertical" Style="display:flex">
                        <FluentStack Style="display:flex;align-items:end">
                            <FluentStack Orientation="Orientation.Vertical" Style="flex:1">
                                <FluentSelect TOption="Option<AudioSource>"
                                              Name="AudioSource"
                                              Label="Audio source"
                                              Items="@ViewModel.AudioSourceOptions"
                                              OptionText="@(p => p.Text)"
                                              OptionValue="@(p => p.Value.ToString())"
                                              Value="@(ViewModel.AudioSource?.ToString() ?? string.Empty)"
                                              ValueChanged="@(v => { if(Enum.TryParse<AudioSource>(v, out var r)) ViewModel.AudioSource = r; })"
                                              Required="true"
                                              Style="width:100%;" />
                            </FluentStack>
                            <FluentButton OnClick="@GenerateAudioAsync"
                                          Loading="@ViewModel.IsGeneratingAudio"
                                          Disabled="@string.IsNullOrWhiteSpace(ViewModel.Headword)"
                                          IconStart="@(new Icons.Regular.Size16.PersonVoice())"
                                          Style="margin-bottom:1px;">
                                Generate
                            </FluentButton>
                        </FluentStack>
                        <FluentValidationMessage For="@(() => ViewModel.AudioSource)" />
                    </FluentStack>

                    <FluentStack Orientation="Orientation.Vertical">
                        <FluentLabel Typo="Typography.Body" Class="uploader-label">Audio preview</FluentLabel>
                        <FluentInputFile Id="audio-uploader"
                                         Accept="audio/*"
                                         OnInputFileChange="HandleChangeAudioAsync"
                                         Style="position:relative;width:100%;">
                            <ChildContent>
                                @if (!string.IsNullOrEmpty(ViewModel.AudioUrl))
                                {
                                    <audio controls style="width:100%;" src="@(ViewModel.AudioPreviewUrl ?? ViewModel.AudioUrl)">
                                        Your browser does not support audio
                                    </audio>
                                    <FluentIcon Value="@(new Icons.Regular.Size20.Dismiss())"
                                                OnClick="ViewModel.ClearAudio"
                                                Style="position:absolute;top:8px;right:8px;cursor:pointer;" />
                                }
                                else
                                {
                                    <label for="audio-uploader">
                                        <FluentIcon Value="@(new Icons.Regular.Size20.Headphones())" />
                                    </label>
                                }
                            </ChildContent>
                        </FluentInputFile>
                        <FluentValidationMessage For="@(() => ViewModel.AudioUrl)" />
                    </FluentStack>
                </FluentStack>

                <FluentStack Orientation="Orientation.Vertical" VerticalGap="12" Style="margin-top:24px">
                    <FluentStack>
                        <div class="section-header-indicator"></div>
                        <div class="section-header-title">Illustration</div>
                    </FluentStack>

                    <FluentStack Orientation="Orientation.Vertical" Style="display:flex">
                        <FluentStack Style="display:flex;align-items:end">
                            <FluentStack Orientation="Orientation.Vertical" Style="flex:1">
                                <FluentSelect TOption="Option<ImageSource>"
                                              Name="ImageSource"
                                              Label="Image source"
                                              Items="@ViewModel.ImageSourceOptions"
                                              OptionText="@(p => p.Text)"
                                              OptionValue="@(p => p.Value.ToString())"
                                              Value="@(ViewModel.ImageSource?.ToString() ?? string.Empty)"
                                              ValueChanged="@(v => { if(Enum.TryParse<ImageSource>(v, out var r)) ViewModel.ImageSource = r; })"
                                              Required="true"
                                              Style="width:100%;" />
                            </FluentStack>
                            <FluentButton OnClick="@LoadMoreImagesAsync"
                                          Loading="@ViewModel.IsLoadingMoreImages"
                                          Disabled="@string.IsNullOrWhiteSpace(ViewModel.Headword)"
                                          IconStart="@(new Icons.Regular.Size16.ArrowSync())"
                                          Style="margin-bottom:1px;">
                                Load more
                            </FluentButton>
                        </FluentStack>
                        <FluentValidationMessage For="@(() => ViewModel.ImageSource)" />
                    </FluentStack>

                    <FluentStack Orientation="Orientation.Vertical">
                        <FluentLabel Typo="Typography.Body" Class="uploader-label">Image preview</FluentLabel>
                        <FluentInputFile Id="image-uploader"
                                         Accept="image/*"
                                         OnInputFileChange="HandleChangeImageAsync"
                                         Style="position:relative;width:100%;">
                            <ChildContent>
                                @if (!string.IsNullOrEmpty(ViewModel.ImageUrl))
                                {
                                    <img src="@ViewModel.ImageUrl" style="width:100%;max-width:500px;border-radius:4px;" />
                                    <FluentIcon Value="@(new Icons.Regular.Size20.Dismiss())"
                                                OnClick="ViewModel.ClearImage"
                                                Style="position:absolute;top:8px;right:8px;cursor:pointer;" />
                                    @if (ViewModel.Images.Count > 1)
                                    {
                                        <FluentButton IconEnd="@(new Icons.Regular.Size20.ChevronRight())"
                                                      Title="@($"Next image ({ViewModel.CurrentImageIndex + 1}/{ViewModel.Images.Count})")"
                                                      OnClick="ViewModel.NextImage"
                                                      Style="position:absolute;top:8px;left:8px;" />
                                    }
                                }
                                else
                                {
                                    <label for="image-uploader">
                                        <FluentIcon Value="@(new Icons.Regular.Size20.Image())" Width="22px" />
                                    </label>
                                }
                            </ChildContent>
                        </FluentInputFile>
                        <FluentValidationMessage For="@(() => ViewModel.ImageUrl)" />
                    </FluentStack>
                </FluentStack>
            </FluentStack>

            <FluentDivider Style="margin:32px 0;" />

            <FluentStack Style="justify-content:end;" HorizontalGap="16">
                <FluentButton OnClick="@ViewModel.ClearForm"
                              Appearance="Appearance.Neutral"
                              Style="min-width:100px">
                    Clear
                </FluentButton>
                <FluentButton OnClick="SubmitAsync"
                              Loading="@ViewModel.IsSubmitting"
                              Appearance="Appearance.Accent"
                              Style="min-width:100px">
                    Create
                </FluentButton>
            </FluentStack>
        </FluentEditForm>
    </FluentStack>
</div>