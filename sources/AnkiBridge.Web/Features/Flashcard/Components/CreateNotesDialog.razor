@using AnkiBridge.Web.Components.Abstractions
@using AnkiBridge.Web.Features.Flashcard.Models

@inherits DialogComponentBase<CreateNotesDialogContent>

<FluentDialogHeader ShowDismiss="true" Style="gap:0">
    <FluentLabel Typo="Typography.H3">
        @Dialog.Instance.Parameters.Title
    </FluentLabel>
</FluentDialogHeader>

<FluentDialogBody>
    <p class="dialog-description">
        Choose the Anki destination for <strong>@Content.LearningEntryIds.Count</strong> selected learning @(Content.LearningEntryIds.Count == 1 ? "entry" : "entries").
    </p>

    <FluentEditForm EditContext="editContext" style="width:100%">
        <DataAnnotationsValidator />

        <div class="destination-grid">
            <div class="field-group">
                <FluentCombobox TOption="AnkiOption"
                                Autocomplete="ComboboxAutocomplete.Both"
                                SelectedOption="Form.SelectedNoteType"
                                SelectedOptionChanged="OnNoteTypeChangedAsync"
                                Name="TargetNoteType"
                                Label="Target note type"
                                Items="Form.NoteTypeOptions"
                                OptionText="@(o => o.Name)"
                                Height="200px"
                                Required="true"
                                Style="width:100%;" />
                <FluentButton Appearance="Appearance.Stealth"
                              OnClick="SyncNoteTypesAsync"
                              IconStart="@(new Icons.Regular.Size16.ArrowSync())">
                    Sync note types with Anki
                </FluentButton>
                <FluentValidationMessage For="@(() => Form.SelectedNoteType)" />
            </div>

            <div class="field-group">
                <FluentCombobox TOption="AnkiOption"
                                Autocomplete="ComboboxAutocomplete.Both"
                                SelectedOption="Form.SelectedDeck"
                                SelectedOptionChanged="OnDeckChangedAsync"
                                Name="TargetDeck"
                                Label="Target deck"
                                Items="Form.DeckOptions"
                                OptionText="@(o => o.Name)"
                                Height="200px"
                                Required="true"
                                Style="width:100%;" />
                <FluentButton Appearance="Appearance.Stealth"
                              OnClick="SyncDecksAsync"
                              IconStart="@(new Icons.Regular.Size16.ArrowSync())">
                    Sync decks with Anki
                </FluentButton>
                <FluentValidationMessage For="@(() => Form.SelectedDeck)" />
            </div>
        </div>
    </FluentEditForm>
</FluentDialogBody>

<FluentDialogFooter>
    <FluentStack HorizontalAlignment="HorizontalAlignment.Right" HorizontalGap="8">
        <FluentButton Appearance="Appearance.Neutral"
                      OnClick="@CancelAsync"
                      Style="min-width:80px">
            Cancel
        </FluentButton>
        <FluentButton Appearance="Appearance.Accent"
                      OnClick="SubmitAsync"
                      Loading="isSubmitting"
                      Style="min-width:80px">
            Create notes
        </FluentButton>
    </FluentStack>
</FluentDialogFooter>
