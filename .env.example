# Copy this file to .env before starting either Compose stack.
# Docker Compose reads .env for interpolation; .env is intentionally not committed.
BIND_ADDRESS=127.0.0.1
ANKIBRIDGE_HTTP_PORT=8080

POSTGRES_HOST_PORT=5432
POSTGRES_DB=ankibridgedb
POSTGRES_USER=postgres
# Required. Replace with a long, random password; never commit the resulting .env file.
POSTGRES_PASSWORD=change-me-to-a-long-random-password

AZURITE_BLOB_PORT=10000
AZURITE_PUBLIC_ENDPOINT=http://localhost:10000

# Docker Desktop resolves this name to the host where Anki is running.
ANKI_CONNECT_URL=http://host.docker.internal:8765

# Optional. Image search needs at least one provider key.
PIXABAY_API_KEY=
PEXELS_API_KEY=
